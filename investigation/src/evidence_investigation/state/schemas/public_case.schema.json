{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PublicCase",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "PublicCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alert": {
          "$ref": "#/$defs/Alert"
        }
      },
      "required": [
        "alert"
      ]
    },
    "Alert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "alert_type": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "command_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/JsonValue"
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/$defs/JsonValue"
                      }
                    }
                  ]
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/JsonValue"
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/$defs/JsonValue"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        "raw_reference": {
          "$ref": "#/$defs/RawReference"
        }
      },
      "required": [
        "alert_id",
        "alert_type",
        "occurred_at",
        "as_of",
        "host",
        "user",
        "process_id",
        "command_line",
        "raw",
        "raw_reference"
      ]
    },
    "RawReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string"
        },
        "json_pointer": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "json_pointer",
        "content_sha256"
      ]
    }
  }
}
