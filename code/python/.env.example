# 大模型配置（兼容 OpenAI 风格接口；不要在模板中填写真实密钥）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_LLM=0
# 国内模型服务链路可能波动，建议保留 90 秒超时
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Neo4j（以下密码仅用于本机演示，正式部署必须修改）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 检索存储：chroma | pgvector
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector（仅在 VECTOR_STORE_TYPE=pgvector 时使用）
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Kafka（可选的增量更新扩展）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 本地 API
API_HOST=0.0.0.0
API_PORT=8080

# 1 = 不调用 Embedding 接口，使用持久化词法检索（国内中转站推荐默认值）
# 0 = 调用 OPENAI_BASE_URL 的 Embedding 接口，需确认账号和模型权限
DISABLE_LOCAL_EMBEDDINGS=1
